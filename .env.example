# AI provider: openai (default) or ollama (local, no API key required).
INSPECTION_AI_PROVIDER=openai
# Cloud mode only: keep this key server-side.
INSPECTION_AI_API_KEY=
INSPECTION_AI_MODEL=gpt-4.1
# Local mode: install Ollama and run: ollama pull qwen2.5vl:3b
# npm run ai:local selects these local settings without removing other configuration.
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=600
PORT=3001
# Hosting only: enable password protection before binding beyond localhost.
# Keep a strong unique password in the hosting provider's secret settings.
HOST=127.0.0.1
FCA_ACCESS_USER=inspector
FCA_ACCESS_PASSWORD=
# Optional: persistent storage directory supplied by your hosting provider.
# FCA_DATA_DIR=/var/data
