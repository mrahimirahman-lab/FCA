# Optional: enables actual AI image analysis. Keep this key server-side.
INSPECTION_AI_API_KEY=
INSPECTION_AI_MODEL=gpt-4.1
PORT=3001
# Hosting only: enable password protection before binding beyond localhost.
# Keep a strong unique password in the hosting provider's secret settings.
HOST=127.0.0.1
FCA_ACCESS_USER=inspector
FCA_ACCESS_PASSWORD=
# Optional: persistent storage directory supplied by your hosting provider.
# FCA_DATA_DIR=/var/data
